{
  "name": "filing-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rls": "vitest run tests/rls",
    "test:e2e": "playwright test",
    "seed:gen": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-seed.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:rls && npm run build && npm run check:bundle && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
